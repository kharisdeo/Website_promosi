# Local durable content store. Relative paths resolve from the project root.
CONTENT_STORE_PATH=.data/content.json

# Required for /api/admin/* endpoints. Keep this value out of source control.
ADMIN_API_TOKEN=change-me-in-local-env
# Token role: super_admin (full access) or editor (content only).
ADMIN_API_ROLE=super_admin

# Optional adaptive CAPTCHA hook for public lead forms.
# When enabled, both values are required and CAPTCHA_VERIFY_URL must accept
# {"secret":"...","response":"..."} and return {"success":true}.
CAPTCHA_REQUIRED=false
CAPTCHA_VERIFY_URL=
CAPTCHA_SECRET=
